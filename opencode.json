{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run mypy*": "allow",
      "uv run pre-commit*": "allow",
      "git add*": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git restore*": "deny",
      "git checkout --*": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "uv add*": "ask",
      "uv remove*": "ask",
      "uv sync*": "ask",
      "pip install*": "deny",
      "pip uninstall*": "deny"
    },
    "edit": "ask",
    "external_directory": "deny"
  }
}
